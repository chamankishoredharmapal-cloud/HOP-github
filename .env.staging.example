# ============================================================
# HOP STAGING ENVIRONMENT — EXAMPLE TEMPLATE
# STAGING ONLY — NEVER COMMIT ACTUAL VALUES
# Copy to .env.staging.local and fill in actual values
# ============================================================

# ----------------------------
# Supabase public frontend data
# Safe for browser use (anon key only)
# ----------------------------

# Supabase project API URL (staging)
VITE_SUPABASE_URL=https://your-staging-project.supabase.co

# Supabase anonymous/publishable key (safe for client)
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ----------------------------
# Razorpay public frontend key
# Safe for browser use ONLY when it is a Test Mode key (rzp_test_*)
# ----------------------------

# Razorpay Test Mode key ID (starts with rzp_test_)
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id_here

# ----------------------------
# Supabase project metadata
# ----------------------------

# Staging Supabase project reference ID
SUPABASE_PROJECT_REF=your_staging_project_ref

# ----------------------------
# Server-only Supabase credential
# NEVER expose to Vite or browser code.
# Used only by staging scripts and Edge Functions.
# ----------------------------

# Supabase service role key (server-only, full admin access)
SUPABASE_SERVICE_ROLE_KEY=

# ----------------------------
# Server-only Razorpay credentials
# NEVER expose to frontend.
# ----------------------------

# Razorpay Test Mode key ID (same as VITE_RAZORPAY_KEY_ID)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here

# Razorpay Test Mode secret key (server-only)
RAZORPAY_KEY_SECRET=

# Razorpay webhook signing secret (HMAC secret, NOT a URL)
# Set this in Razorpay Dashboard → Webhooks → Signing Secret
RAZORPAY_WEBHOOK_SECRET=

# ----------------------------
# Staging URLs
# ----------------------------

# Staging frontend origin (Cloudflare Pages / Workers)
FRONTEND_URL=https://your-staging-frontend.workers.dev

# Razorpay webhook endpoint URL (where Razorpay sends events)
RAZORPAY_WEBHOOK_URL=https://your-staging-project.supabase.co/functions/v1/razorpay-webhook

# Payment verification endpoint
VERIFY_PAYMENT_URL=https://your-staging-project.supabase.co/functions/v1/verify-payment

# Order creation endpoint
CREATE_ORDER_URL=https://your-staging-project.supabase.co/functions/v1/create-razorpay-order

# ----------------------------
# Staging test account
# ----------------------------

# Test customer email for staging validation
TEST_CUSTOMER_EMAIL=your_test_email@example.com

# Test customer password (use a unique, non-trivial password)
TEST_CUSTOMER_PASSWORD=